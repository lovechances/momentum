{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "incremental": false,
    "composite": false,
    "noEmit": true
  },
  "include": ["vite.config.ts", "api/**/*.ts"],
  "exclude": ["api/**/*.test.ts", "api/**/*.test.tsx"]
}
