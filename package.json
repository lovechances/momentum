{
  "name": "momentum",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run check:api && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p api/tsconfig.json --noEmit",
    "check:api": "vitest run api/_ai.test.ts",
    "test": "vitest run",
    "lint": "eslint src api --ext .ts,.tsx"
  },
  "dependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "vitest": "5.0.0"
  }
}
